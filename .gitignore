# Extraction outputs and downloaded tools - never commit game assets or
# large binaries. These are regenerated by running ./datamine.sh.
/out/
/_tools/

# Never commit the game package itself (copyrighted, and huge).
*.apk
*.xapk
*.apks
*.aab
*.obb

# Python / OS noise
__pycache__/
*.pyc
.DS_Store
